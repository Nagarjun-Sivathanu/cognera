# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). `.env.local` is gitignored.
#
# Both of these are SAFE to expose in the browser bundle:
#   - the project URL is just an address
#   - the anon key is designed to be public; what it can actually do is controlled
#     by the row-level security policies on the database, not by keeping it secret
#
# NEVER put the `service_role` key here, or anywhere in this project. It bypasses
# all row-level security. It has no use in a browser app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
