{
  "name": "cp0-dungeon-crawler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:calculus": "esbuild scripts/check_calculus.ts --bundle --platform=node --format=esm --outfile=node_modules/.calccheck.mjs && node node_modules/.calccheck.mjs",
    "check:chemistry": "esbuild scripts/check_chemistry.ts --bundle --platform=node --format=esm --outfile=node_modules/.chemcheck.mjs && node node_modules/.chemcheck.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
